{
  "name": "sistema-portaria-dev",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode demo",
    "dev:cloud": "vite --mode devcloud",
    "dev:configure": "node --experimental-strip-types scripts/configure-dev.ts",
    "build": "npm run typecheck && vite build --mode devcloud",
    "build:dev": "npm run build",
    "lint": "eslint .",
    "preview": "vite preview --mode devcloud",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.tools.json",
    "test": "node --no-warnings --experimental-strip-types --test tests/*.test.ts",
    "test:db": "node --no-warnings --experimental-strip-types --test tests/database.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "dev:sql": "node --experimental-strip-types scripts/prepare-dev-sql.ts",
    "dev:assets": "node scripts/generate-demo-assets.mjs",
    "dev:offline": "node scripts/start-offline.mjs",
    "test:browser": "playwright test",
    "dev:demo": "vite --mode demo",
    "dev:original": "vite --mode original",
    "original:configure": "node --experimental-strip-types scripts/configure-original.ts",
    "original:compare": "node --experimental-strip-types scripts/compare-original.ts",
    "original:preflight-prepare": "node --experimental-strip-types scripts/prepare-original-preflight.ts",
    "original:preflight-compare": "node --experimental-strip-types scripts/compare-original-preflight.ts",
    "original:prepare": "node --experimental-strip-types scripts/prepare-original.ts",
    "build:demo": "npm run typecheck && vite build --mode demo",
    "backup:verify": "node scripts/verify-backup.mjs",
    "original:authorize-write": "node --experimental-strip-types scripts/authorize-original-write.ts",
    "original:lock": "node --experimental-strip-types scripts/lock-original.ts",
    "build:original": "npm run typecheck && vite build --mode original",
    "build:netlify": "npm run typecheck && vite build --mode original"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "^0.344.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "^15.9.0",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
